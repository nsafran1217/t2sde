[I] The SDE's source code

[T] This package contains the T2 SDE source code: the build scripts and
[T] package descriptions (also knows as repositories) - installed in /usr/src.

[U] https://github.com/nsafran1217/t2sde/tree/25.10-altix

[A] The T2 Project <t2@exactcode.de>
[M] Rene Rebe <rene@t2-project.org>

[C] base/development

[F] CROSS

[L] GPL

[S] Stable

[V] 25.10

srctar= runmake=0

src_main() {
    local gitdir=$root/usr/src/$pkg/.git
    ln -srfv $root/usr/src/$pkg/t2 $root$sbindir/t2
    [ -e $root/usr/src/$pkg ] && return
    mkdir -pv $root/usr/src/$pkg
    cp -rfv $base/.git $root/usr/src/$pkg/ 2>/dev/null || true
    cp -fv $base/t2 $root/usr/src/$pkg/
    if [ -d "$gitdir" ]; then
        git -C $root/usr/src/$pkg remote set-url origin \
            https://github.com/nsafran1217/t2sde
        git -C $root/usr/src/$pkg symbolic-ref HEAD \
            refs/heads/25.10-altix 2>/dev/null || true
    fi
}

hook_add postmake 5 "src_main"
